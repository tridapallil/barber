# Conexão com o MongoDB (obrigatória)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=salao

# Porta do servidor (padrão 3210)
# PORT=3210

# Chave que assina o cookie de sessão.
# Sem ela, uma é gerada e guardada no próprio banco.
# Em produção, defina: openssl rand -hex 48
# SALAO_SEGREDO=

# Defina como 1 apenas quando o site for servido por HTTPS.
# Em acesso por http://ip-da-rede o cookie secure não é enviado e o login falha.
# SALAO_COOKIE_SECURE=1

# Só para o docker-compose
# MONGO_USUARIO=salao
# MONGO_SENHA=troque-esta-senha
